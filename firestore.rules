rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'godwinthompson067@gmail.com' && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Designs Collection
    match /designs/{designId} {
      function isValidDesign(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 100
            && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 1000
            && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 1000))
            && data.category in ["Social Media Designs", "Web3 Designs", "Print Media", "Flyers/Posters", "Product Designs", "Motion Graphics"]
            && data.likes is int && data.likes >= 0
            && data.views is int && data.views >= 0
            && data.createdAt is timestamp;
      }

      allow read, list: if true;
      
      allow create: if isAdmin() 
                    && isValidId(designId) 
                    && isValidDesign(incoming())
                    && incoming().likes == 0
                    && incoming().views == 0;

      allow update: if (isAdmin() && isValidDesign(incoming()))
                    || (
                      isSignedIn() 
                      && isValidDesign(incoming())
                      && (
                        // Action: Like increment
                        (incoming().diff(existing()).affectedKeys().hasOnly(['likes']) && incoming().likes == existing().likes + 1)
                        || 
                        // Action: View increment
                        (incoming().diff(existing()).affectedKeys().hasOnly(['views']) && incoming().views == existing().views + 1)
                      )
                    );

      allow delete: if isAdmin();

      // 2. Reviews Sub-collection
      match /reviews/{reviewId} {
        function isValidReview(data) {
          return data.reviewerName is string && data.reviewerName.size() > 0 && data.reviewerName.size() <= 50
              && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 1000
              && data.createdAt is timestamp;
        }

        allow read, list: if true;
        allow create: if isSignedIn() 
                      && isValidId(reviewId)
                      && isValidReview(incoming())
                      && exists(/databases/$(database)/documents/designs/$(designId));
        allow delete: if isAdmin();
      }
    }

    // 3. Inquiries Collection
    match /inquiries/{inquiryId} {
      function isValidInquiry(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 100
            && data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
            && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
            && data.createdAt is timestamp;
      }

      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read, list, delete: if isAdmin();
    }
  }
}
